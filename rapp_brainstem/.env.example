# GitHub token — get yours from: gh auth token
# Or run `gh auth login` first and leave this blank (auto-detected)
GITHUB_TOKEN=

# Model to use (Copilot supports: gpt-4o, gpt-4o-mini, gpt-4.1, o3-mini, claude-3.5-sonnet)
GITHUB_MODEL=gpt-4o

# Point to your private soul and agents (optional — defaults to ./soul.md and ./agents/)
SOUL_PATH=./soul.md
AGENTS_PATH=./agents

# Port (default: 7071)
PORT=7071

# Password for voice.zip (ElevenLabs API key config)
VOICE_ZIP_PASSWORD=

# ── MCAPS Environment (alternative to env.yaml) ───────────────────────────
# These override env.yaml values if set. Most SEs should just use env.yaml instead.
# MCAPS_TENANT_DOMAIN=MngEnvMCAPXXXXXX.onmicrosoft.com
# MCAPS_LOGIN_HINT=yourname@microsoft.com
# MCAPS_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# MCAPS_DEFAULT_REGION=westus3
# OWNER_NAME=YourName
