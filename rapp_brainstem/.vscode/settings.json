{
  "liveServer.settings.ignoreFiles": [
    ".brainstem_data/**",
    "**/__pycache__/**",
    "*.pyc",
    "*.log"
  ],
  "chat.agentSkillsLocations": {
    ".agents/skills": true,
    ".github/skills": true,
    ".claude/skills": true,
    "~/.agents/skills": true,
    "~/.copilot/skills": true,
    "~/.claude/skills": true,
    "~/.vscode/extensions/synapsevscode.synapse-1.23.0/copilot/skills": true
  },
  "chat.tools.terminal.autoApprove": {
    "/^python brainstem\\.py$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}
