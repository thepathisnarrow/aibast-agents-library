# ─────────────────────────────────────────────────────────────────────────────
# RAPP Brainstem — SE Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `env.yaml` and fill in YOUR MCAPS managed-environment values.
#
#   cp env.yaml.example env.yaml
#
# Each Solutions Engineer gets a managed environment: MngEnvMCAPXXXXXX
# Find yours at: https://portal.azure.com → Azure Active Directory → Overview
# ─────────────────────────────────────────────────────────────────────────────

# ── Your MCAPS Managed Environment ─────────────────────────────────────────
tenant:
  # Your MngEnvMCAP tenant domain (e.g., MngEnvMCAP874580.onmicrosoft.com)
  domain: "MngEnvMCAPXXXXXX.onmicrosoft.com"

  # Your Microsoft email (e.g., yourname@microsoft.com)
  login_hint: "yourname@microsoft.com"

  # Friendly display name for logs/prompts
  display_name: "MCAPS (Demo Environment)"

  # Managed Environment Admin (MEA) — the tenant-native admin account
  # This is the admin@MngEnvMCAPXXXXXX.onmicrosoft.com account that has full
  # tenant-native permissions (Fabric capacity admin, etc.)
  # At startup, you'll be prompted to authenticate as this user for admin ops.
  mea_admin: "admin@MngEnvMCAPXXXXXX.onmicrosoft.com"

# ── Azure Subscription ─────────────────────────────────────────────────────
subscription:
  # Find via: az account list --query "[?tenantId=='<your-tenant-guid>'].id" -o tsv
  id: "00000000-0000-0000-0000-000000000000"

  # Preferred Azure region (westus3, eastus2, etc.)
  default_region: "westus3"

# ── Secondary Tenants (Multi-Account) ──────────────────────────────────────
# Optional: Add secondary tenants to pull Fabric/Purview data from other orgs.
# Uses InteractiveBrowserCredential with persistent token cache — logs in via
# browser once, then uses cached refresh token on subsequent starts.
#
# Each secondary tenant is identified by a short key (e.g., "onemtc").
# Set admin_access: false if the account doesn't have capacity admin rights.
secondary_tenants:
  # onemtc:
  #   tenant_id: "72f988bf-86f1-41af-91ab-2d7cd011db47"
  #   login_hint: "davidwin@onemtc.net"
  #   display_name: "OneMTC (EXP)"
  #   subscription_id: ""  # optional — only needed if you want ARM data
  #   purview_account: ""  # optional — e.g., "onemtc-purview"
  #   admin_access: false  # no capacity resume/pause

# ── Safety ─────────────────────────────────────────────────────────────────
# Display name used in safety-constraint messages (who must approve destructive ops)
owner_name: "Dave"

# ── Existing Shared Resources (NEVER recreated by architect agents) ────────
# Brainstem's azure_architect/purview_architect agents are FORBIDDEN from
# creating new Fabric capacities or Purview accounts. Point them at the ones
# you already provisioned so they reuse them across every demo build.
fabric:
  capacity_id: ""            # full ARM resource id of your existing F-sku capacity
  default_workspace_id: ""   # optional default workspace GUID for demos

purview:
  account_name: ""           # name of your existing Purview account

